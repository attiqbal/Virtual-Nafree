# Copy to .env and fill in. Never commit real keys.
# Claude API key (console.anthropic.com). Required in production; without it in development employees give mock answers.
ANTHROPIC_API_KEY=

# --- API server (npm run dev:api) ---
# Required in production. Any long random string.
SESSION_SECRET=
# Development only: sign up by email with no verification. The server refuses to start in production with this on.
ALLOW_DEV_AUTH=
# The MAIZ platform owner(s), comma-separated. Only these signed-in emails see the quality review queue
# (web/review.html) and sign off clients' specialised tasks; they also get review and setup alerts by email.
# Required in production. Clients can never approve their own specialised tasks.
PLATFORM_OWNER_EMAILS=
# Resend, Google/Microsoft sign-in, Slack, Xero and Square can instead be typed on the owner's Connections page
# (/owner-connections.html), stored encrypted. A complete set here wins over what was typed there.
# Sign in with Google / Microsoft (optional; each needs both halves, and APP_URL). Register this return address with the provider:
#   <APP_URL>/api/signin/oauth/google/callback   and   <APP_URL>/api/signin/oauth/microsoft/callback
# Microsoft: in the app registration add the optional ID-token claim "xms_edov" so work accounts can be trusted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (default) = work and personal accounts; or one tenant id/domain.
MICROSOFT_TENANT=

# Slack app (api.slack.com/apps). All four are needed to turn Slack on.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=

# --- Business apps (optional). Each pair turns on "Connect" for that app; without it the app falls back to file upload or Zapier.
# Redirect URI to register with each app: <APP_URL>/api/integrations/callback
# Xero: developer.xero.com/app/manage (granular scope accounting.reports.profitandloss.read)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Square: developer.squareup.com/apps (OAuth, scope PAYMENTS_READ). SQUARE_BASE_URL=https://connect.squareupsandbox.com for the sandbox.
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_BASE_URL=

# --- Storage (Postgres). Without DATABASE_URL the API keeps data in memory. Required in production. ---
# Platform role: creates customers, loads data at start (bypasses row-level security). Keep this secret and server-side only.
DATABASE_URL=
# Customer role app_user: every write runs inside one customer's workspace.
DATABASE_APP_URL=
# 64 hex characters (32 bytes) that encrypt chat bot tokens at rest. Generate: openssl rand -hex 32
TOKEN_KEY=

# --- Sign-in emails (Resend, resend.com). Without these, development prints the sign-in link in the API log. Required in production. ---
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, for example "MAIZ Agents <hello@yourdomain.com>"
EMAIL_FROM=
# Optional help address shown in email footers. Leave empty to show none.
SUPPORT_EMAIL=
# Public address of the website, used in sign-in links, for example https://app.yourdomain.com
APP_URL=

# --- AI ---
# Optional: override the default Claude model id used by the gateway (the Claude-only baseline for standard work).
ANTHROPIC_MODEL=
# RunPod Serverless endpoint running the vLLM worker (OpenAI-compatible). RunPod does the heavy lifting and Claude
# only checks it, to keep Claude spend low. Set both or neither; without them Claude does all the work.
# The endpoint id is the short id from the endpoint's URL (not the URL itself). Never paste these into chat.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Models, pass marks, check rates and budget caps are not env vars: the platform owner edits them on /owner-ai.html.

# --- Payments ---
# No real payment provider is built yet, so leave this empty in production: checkout is then refused and nothing is charged.
# "mock" (development only, refused in production) charges nobody and hands the purchase over at once.
# "stripe" turns on Stripe Checkout, billing and invoices. Leave empty to keep payments off (the feature flag).
# Test-mode keys only until the owner says go live. Put these in the server's secrets, never in chat or git.
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 only after Stripe Tax has an active registration (otherwise Stripe collects no tax).
STRIPE_AUTOMATIC_TAX=
# Deliberate opt-ins: live keys take real money; test keys in production let anyone get paid items free.
STRIPE_ALLOW_LIVE=
STRIPE_ALLOW_TEST_IN_PRODUCTION=

# --- Facebook / Instagram / WhatsApp for the owner-only promotion agent (optional; setup in docs/META-WHATSAPP.md) ---
# Server secrets only, never in chat or git. Each group is all-or-nothing.
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# A string you choose (16+ characters); type the same one into Meta's webhook page.
WHATSAPP_VERIFY_TOKEN=
# Your own number with country code, for example +447700900123. Only this number may command the agent.
WHATSAPP_OWNER_NUMBER=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=

# --- Hosting ---
# Public address of the website at build time (canonical links, sitemap, Open Graph). Usually the same as APP_URL.
SITE_URL=
# Port to listen on. Hosts such as Render set this for you.
PORT=
# Set to 1 when behind a proxy that appends the client address to X-Forwarded-For (always on in production).
TRUST_PROXY=
# Optional: folder with the built website. Default web/dist. Leave empty to serve it from the same service.
WEB_DIST=
